# Claude API key (https://console.anthropic.com). Without it FinPilot runs in labeled offline demo mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = fastest responses for a live demo
CLAUDE_EFFORT=low

# SQLite file for audit log, actions, consent and settings
DATABASE_PATH=data/finpilot.db
# Probability that a mock bank call fails (handled with retries)
MOCK_BANK_FAILURE_RATE=0.1
# Optional fixed "today" for reproducible demos, e.g. 2026-11-21
DEMO_TODAY=

# Onboarding / auth
# true: SMS codes are shown on screen (hackathon demo)
DEMO_MODE=true
# demo | eskiz (Eskiz.uz needs ESKIZ_EMAIL and ESKIZ_PASSWORD)
SMS_PROVIDER=demo
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546
SESSION_TTL_MINUTES=120
